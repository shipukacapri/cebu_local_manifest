<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote
        name="github"
        fetch="https://github.com/" />

  <remote
        name="gitlab-deivid"
        fetch="https://gitlab.com/Deivid21/" />
  
  <!-- Device tree for Motorola G9 Power cebu (your fork) -->
  <project
      path="device/motorola/cebu"
      name="shipukacapri/android_device_motorola_cebu"
      remote="github"
      revision="voltage" />

 <!-- Common device tree for sm6225 platform (your fork) -->
  <project
      path="device/motorola/sm6225-common"
      name="shipukacapri/android_device_motorola_sm6225-common"
      remote="github"
      revision="voltage-dolby" />

   <!-- Kernel tree (your fork) -->
  <project
      path="kernel/motorola/sm6225"
      name="LineageOS/android_kernel_motorola_sm6225"
      remote="github"
      revision="lineage-23.2" />
  
  <!-- Vendor blobs for cebu (your fork) -->
  <project
      path="vendor/motorola/cebu"
      name="TheMuppets/proprietary_vendor_motorola_cebu"
      remote="github"
      revision="lineage-23.2" />

