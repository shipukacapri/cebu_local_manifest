  <project
      path="vendor/motorola/sm6225-common"
      name="TheMuppets/proprietary_vendor_motorola_sm6225-common"
      remote="github"
      revision="lineage-23.2" />
  
<!-- Motorola hardware (contains hardware/motorola/sepolicy/qti/SEPolicy.mk) -->
